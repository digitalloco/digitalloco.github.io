---
import Base from '../../layouts/Base.astro';
import { getPosts, tagUrl } from '../../lib/posts';

const tags = [...new Set((await getPosts()).flatMap((p) => p.data.tags))].sort();
---

<Base title="Tags">
  <h1>Tags</h1>
  {
    tags.length > 0 ? (
      <ul>
        {tags.map((tag) => (
          <li>
            <a href={tagUrl(tag)}>{tag}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p>No tags yet.</p>
    )
  }
</Base>

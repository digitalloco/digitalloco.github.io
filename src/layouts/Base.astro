---
import { SITE_DESCRIPTION, SITE_TITLE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  // Site-relative path of the social preview image (1200 x 630 PNG).
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = '/og/site.png',
  ogType = 'website',
} = Astro.props;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const site = Astro.site ?? new URL('https://digitalloco.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={SITE_TITLE} />

    <!-- Social preview: what a shared link shows -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Apply a saved light/dark choice before first paint, so the page
      // does not flash in the wrong scheme. No saved choice: follow the
      // browser setting.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {
        // Storage blocked (private window); follow the browser setting.
      }
    </script>
    <style is:global>
      /* One readable column, browser light/dark colours, nothing decorative.
         The toggle only changes color-scheme; the browser picks the colours,
         and highlighted code follows through CSS light-dark(). */
      :root { color-scheme: light dark; }
      :root[data-theme='light'] { color-scheme: light; }
      :root[data-theme='dark'] { color-scheme: dark; }
      body { max-width: 42rem; margin: 0 auto; padding: 1rem; font-family: system-ui, sans-serif; line-height: 1.6; }
      header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid #8886; padding-bottom: 0.5rem; }
      header .site { font-weight: bold; text-decoration: none; }
      header nav { display: flex; align-items: baseline; gap: 1rem; }
      header button { font: inherit; font-size: 0.9rem; }
      footer { margin-top: 3rem; border-top: 1px solid #8886; padding-top: 0.5rem; font-size: 0.9rem; }
      img { max-width: 100%; height: auto; }
      pre { overflow-x: auto; padding: 0.5rem; border: 1px solid #8886; }
      table { display: block; overflow-x: auto; border-collapse: collapse; }
      th, td { padding: 0.25rem 0.5rem; border-bottom: 1px solid #8886; text-align: left; }
      ul.posts { list-style: none; padding: 0; }
      ul.posts li { margin-bottom: 0.75rem; }
      time { white-space: nowrap; }
      nav.toc { border: 1px solid #8886; padding: 0 1rem; margin: 1rem 0; }
      nav.toc ul { padding-left: 1.25rem; }
      nav.toc li.sub { margin-left: 1rem; }
      /* Commentary: our opinion, kept visibly apart from sourced fact.
         Written in Markdown as a blockquote starting "**Commentary ...**". */
      blockquote { margin: 1rem 0; padding: 0.25rem 1rem; border-left: 4px solid #8888; background: #8881; }
      /* Skip link: off-screen until it has keyboard focus. */
      .skip { position: absolute; left: -999rem; }
      .skip:focus { left: 1rem; top: 1rem; padding: 0.25rem 0.5rem; background: Canvas; border: 1px solid; }
      footer nav { display: flex; gap: 1rem; }
      nav.adjacent { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; border-top: 1px solid #8886; padding-top: 0.5rem; }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="site" href="/">{SITE_TITLE}.com</a>
      <nav>
        <a href="/blog/">Blog</a>
        <a href="/docs/">Docs</a>
        <a href="/tags/">Tags</a>
        <a href="/search/">Search</a>
        <!-- Hidden until the script below runs: no dead button without JavaScript -->
        <button type="button" id="theme-toggle" hidden>Light/dark</button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <nav aria-label="Site">
        <a href="/about/">About</a>
        <a href="/blog/archive/">Archive</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <p>
        digitalloco is currently a personal hobby project. Nothing here
        is for sale.
      </p>
      <p>
        RailCom is a registered trademark of Lenz Elektronik GmbH.
        DCC-EX is the name of the DCC-EX project. This site is not
        affiliated with either.
      </p>
      <p>&copy; {new Date().getFullYear()} <a href="/about/">Phil Claridge</a>. All rights reserved.</p>
    </footer>
    <script is:inline>
      // Light/dark toggle: flip from whatever is showing now, remember it.
      (function () {
        const button = document.getElementById('theme-toggle');
        if (!button) return;
        button.hidden = false;
        button.addEventListener('click', function () {
          const root = document.documentElement;
          const showing =
            root.dataset.theme ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = showing === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            // Not remembered; still applies to this page.
          }
        });
      })();
    </script>
  </body>
</html>
